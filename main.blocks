e"><block type="argument_reporter_custom" id="5~yVh5L??@2HGvVJ@b$L"><mutation duplicateondrag="true" typename="Sprite"></mutation><field name="VALUE">sprite</field></block></value><value name="kind"><shadow type="spritekind" id="`lQ6eg}O3-l%TUh/Iaf}"><field name="MEMBER">Player</field></shadow></value><value name="HANDLER_DRAG_PARAM_otherSprite"><block type="argument_reporter_custom" id="YdIh{GsCtQfvA7qa*CUi"><mutation duplicateondrag="true" typename="Sprite"></mutation><field name="VALUE">otherSprite</field></block></value><value name="otherKind"><shadow type="spritekind" id="BGxj_#,0bHJpjJtl4e+b"><field name="MEMBER">villager</field></shadow></value><statement name="HANDLER"><block type="spritesetkind" id="42[DL`QFN~##}S]KO_a1"><value name="sprite"><block type="argument_reporter_custom" id="F~N`2|@RE8rfC{lHIS5M"><mutation typename="Sprite"></mutation><field name="VALUE">otherSprite</field></block></value><value name="kind"><shadow type="spritekind" id="x}]%pK+Mmu6HK?an@gS:"><field name="MEMBER">tile_detect</field></shadow></value><next><block type="controls_if" id="~k;69@emd.~i6k`asF?j"><mutation else="1"></mutation><value name="IF0"><shadow type="logic_boolean" id="V-OAg@;_t+SlMx8/glnf"><field name="BOOL">TRUE</field></shadow><block type="logic_negate" id="!,WDBz^@d`QuczyyV=d3"><value name="BOOL"><block type="variables_get" id="[aueiSBk85.#$gBIO^EY"><field name="VAR" id="*lXh@#`y]q~V0IxyjS{A">alt music</field></block></value></block></value><statement name="DO0"><block type="game_show_long_text" id="*qRnaS$ORB:@xpKL.!X."><field name="layout">DialogLayout.Bottom</field><value name="str"><shadow type="text" id="M{;[/he/b{#qtK3HWzfJ"><field name="TEXT"></field></shadow><block type="array_pickRandom" id="eA0x1D0}A%Op+WFf:^be"><value name="list"><block type="lists_create_with" id="jL~$5MTqsC@7abA7E]zO" inline="false"><mutation items="6" horizontalafter="3"></mutation><value name="ADD0"><block type="text" id="w54e|r{6mb6DBz_eWE?B"><field name="TEXT">how are you doing, princess from the cold realm?</field></block></value><value name="ADD1"><block type="text" id="b.KXY@z)Fe5i}7Cq)bsU"><field name="TEXT">Found a portal yet? it's getting cold, FAST!</field></block></value><value name="ADD2"><block type="text" id="6Y2WdsUVDyRpL)DkG;Mv"><field name="TEXT">brr...</field></block></value><value name="ADD3"><block type="text" id="=}8$Ng([87_*#xFhOoka"><field name="TEXT">it's warmer here than anywhere else, but still cold</field></block></value><value name="ADD4"><block type="text" id="p;g=9=j/?@|zJ)0qR-qZ"><field name="TEXT">hi. wait, you're going to find us a warmer dimension? COOL!</field></block></value><value name="ADD5"><block type="text" id="M^{O%r$@kg./XGB!]iGx"><field name="TEXT">what took you so long? it's still freezing, but maybe that book will help..</field></block></value></block></value></block></value></block></statement><statement name="ELSE"><block type="game_show_long_text" id="(DUhu+/3=rj!@k%B1R]7"><field name="layout">DialogLayout.Bottom</field><value name="str"><shadow type="text" id="x)=c;iO0q*w+14pMP(tX"><field name="TEXT"></field></shadow><block type="array_pickRandom" id="P(-f6]OGzfDwbIMTq8}k"><value name="list"><block type="lists_create_with" id="FVqs;nr70feS)tu|9^~!" inline="false"><mutation items="6" horizontalafter="3"></mutation><value name="ADD0"><block type="text" id=")r!8a6%%?mkG%3!9F2;S"><field name="TEXT">how are you doing, princess from the cold realm?</field></block></value><value name="ADD1"><block type="text" id="c}hp1nP@E0%f3_Vqg@ow"><field name="TEXT">it's nice here</field></block></value><value name="ADD2"><block type="text" id="$x$vrk{u@7E*.rclI]Gg"><field name="TEXT">coming back here soon enough? oh right, it's too warm here for you.</field></block></value><value name="ADD3"><block type="text" id="wBH/G!}yR7x|KgXP)@+R"><field name="TEXT">nice and toasty</field></block></value><value name="ADD4"><block type="text" id="S5jIL:nthmD77a?yJ,$J"><field name="TEXT">funally, you found it!</field></block></value><value name="ADD5"><block type="text" id="kiGa|/{JKTfumDzV@{JO"><field name="TEXT">i guess that book really did help! </field></block></value></block></value></block></value></block></statement><next><block type="device_pause" id="W6N#Clp137#+%oQdn6PG"><value name="pause"><shadow type="timePicker" id=")TB0l:EJ#??q^PR#1Gev"><field name="ms">5000</field></shadow></value><next><block type="spritesetkind" id="pq:7#83i8Z|whA$z]u,n"><value name="sprite"><block type="argument_reporter_custom" id="k+ATDhtrJ3tosO_[sTEe"><mutation typename="Sprite"></mutation><field name="VALUE">otherSprite</field></block></value><value name="kind"><shadow type="spritekind" id="ju]ngdWK?(juT1PO-H{m"><field name="MEMBER">villager</field></shadow></value></block></next></block></next></block></next></block></statement></block><block type="spritesoverlap" id="A`F%W?p^V`OIbohNKK4y" x="2167" y="3449"><value name="HANDLER_DRAG_PARAM_sprite"><block type="argument_reporter_custom" id="#!wy?X{`L!NK`0-$L1IP"><mutation duplicateondrag="true" typename="Sprite"></mutation><field name="VALUE">sprite</field></block></value><value name="kind"><shadow type="spritekind" id="U,HXBbH/iRcP]OU^9dya"><field name="MEMBER">Player</field></shadow></value><value name="HANDLER_DRAG_PARAM_otherSprite"><block type="argument_reporter_custom" id="4o_!h7KX7GYXJDLqjPv7"><mutation duplicateondrag="true" typename="Sprite"></mutation><field name="VALUE">otherSprite</field></block></value><value name="otherKind"><shadow type="spritekind" id="(KUK5?a(g$z-t#*Xr$ch"><field name="MEMBER">neutral_enemy</field></shadow></value><statement name="HANDLER"><block type="controls_if" id="lRm_M2^m8Yd{REtEF#y0"><value name="IF0"><shadow type="logic_boolean" id="JLB+#!xZBP:Gy.ora_Q3"><field name="BOOL">TRUE</field></shadow><block type="logic_operation" id="RAUxKg=2WM{1]h433-3;"><field name="OP">AND</field><value name="A"><block type="logic_compare" id="F*+n!p$7DDXpjYUEnJX]"><field name="OP">GT</field><value name="A"><shadow type="math_nu