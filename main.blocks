<block type="sprites_destroy_all_sprites_of_kind" id="SVU%(QQpg~SL*G,,*?m5"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><field name="effect">effects.spray</field><value name="kind"><shadow type="spritekind" id="JwA}z4|:,V=B[e~g~-ue"><field name="MEMBER">neutral_enemy</field></shadow></value><value name="duration"><shadow type="timePicker" id="4T#KW@Ocm[uL+$!_BBG+"><field name="ms">500</field></shadow></value><next><block type="function_call" id="Q4W/I9ZRbe6pk1*ck[i#"><mutation name="spawn" functionid="iO_0RsL%St83y_#nL,7f"></mutation></block></next></block></next></block></statement></block><block type="spriteshittile" id="oSKG6DuC(~|1wyuxBqm~" x="3947" y="1600"><value name="HANDLER_DRAG_PARAM_sprite"><block type="argument_reporter_custom" id="SueyJfw62!/Y:`aLbf7:"><mutation duplicateondrag="true" typename="Sprite"></mutation><field name="VALUE">sprite</field></block></value><value name="kind"><shadow type="spritekind" id="+@bP3hX-E}_u6sQYPk=O"><field name="MEMBER">Player</field></shadow></value><value name="tile"><shadow type="tileset_tile_picker" id="@4*dJno7O%nMO)$|J]L="><field name="tile">assets.tile`table`</field></shadow></value><value name="HANDLER_DRAG_PARAM_location"><block type="argument_reporter_custom" id="7.+uk+OJRoN;|2*_ZM)-"><mutation duplicateondrag="true" typename="tiles.Location"></mutation><field name="VALUE">location</field></block></value><statement name="HANDLER"><block type="controls_if" id="^M2h8}3eUXO2pqls6Jt."><value name="IF0"><shadow type="logic_boolean" id="h7!F({MS2j6CNh,F;Q*a"><field name="BOOL">TRUE</field></shadow><block type="variables_get" id="Q}@55T4CDn@r4;FezkKc"><field name="VAR" id="d^c-#|GLEyoY._~6yJ6t">check_lore</field></block></value><statement name="DO0"><block type="variables_set" id="XSg*2Ds5g;0E$+s:fX.;"><field name="VAR" id="d^c-#|GLEyoY._~6yJ6t">check_lore</field><value name="VALUE"><shadow type="math_number" id="p+TFO{XOV^s;18)q:f)d"><field name="NUM">0</field></shadow><block type="logic_boolean" id="]=HEc|pRF%GV}k.z}mg%"><field name="BOOL">FALSE</field></block></value><next><block type="controls_if" id="bQ{aYiU[gkreWa1B{9Dy"><value name="IF0"><shadow type="logic_boolean" id="5|*}*OYQu85|JQ9gSRWx"><field name="BOOL">TRUE</field></shadow><block type="gameask" id="xsu10|E5%*F~DR9Pa!S@"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><value name="title"><shadow type="text" id="uI)F]a)NaakMt=tS.?xY"><field name="TEXT">do you want to read the book?</field></shadow></value><value name="subtitle"><shadow type="text" id="I%4-IQFhib^[$:*$I)0W"><field name="TEXT"></field></shadow></value></block></value><statement name="DO0"><block type="game_show_long_text" id="bAiVcx`kYtw4:`9b}Y}8"><field name="layout">DialogLayout.Bottom</field><value name="str"><shadow type="text" id="q)RLt#={jxM?S{6=!%/Y"><field name="TEXT">published in 2048, after the globabl freeze</field></shadow></value><next><block type="game_show_long_text" id="x}jswem(_Tf@rA+A`zH6"><field name="layout">DialogLayout.Bottom</field><value name="str"><shadow type="text" id="Zq{9%wyTqBv?CeLz(-,r"><field name="TEXT">THE PAST  by the legendary sheep</field></shadow></value><next><block type="game_show_long_text" id="N`*:POINw4K)DzdMAV6Y"><field name="layout">DialogLayout.Bottom</field><value name="str"><shadow type="text" id="3#X~|L[~cn6ikhMrs{8{"><field name="TEXT">In an era, long ago, there was just a basic jungle</field></shadow></value><next><block type="game_show_long_text" id="7T+]h%^|hSp7#68#`LWa"><field name="layout">DialogLayout.Bottom</field><value name="str"><shadow type="text" id="v/L*FdGwB9!vEey}kmQW"><field name="TEXT">everyone in it was happy and warm, but some could not live there</field></shadow></value><next><block type="game_show_long_text" id="^(0)Ti.`Tu.BJ=myi8kX"><field name="layout">DialogLayout.Bottom</field><value name="str"><shadow type="text" id="KX6iwyzY9GXFJ4OOyOu."><field name="TEXT">because of the temperature, they lived in the mountais</field></shadow></value><next><block type="game_show_long_text" id="mBknD=U/krD+xVQE:SU/"><field name="layout">DialogLayout.Bottom</field><value name="str"><shadow type="text" id=".7qisjK|io?Mf{;gLuZ+"><field name="TEXT">this probably included you, dear reader. </field></shadow></value><next><block type="game_show_long_text" id="o;w*C]=*O{H;1._n{z.M"><field name="layout">DialogLayout.Bottom</field><value name="str"><shadow type="text" id="P9ElDLB7*[#a)EPY3KMq"><field name="TEXT">of course at some point, the world froze over.</field></shadow></value><next><block type="game_show_long_text" id="5j7}g)Y+K$nIw-}XvZe*"><field name="layout">DialogLayout.Bottom</field><value name="str"><shadow type="text" id="C_-9h@nA!NS;-eaoGWSj"><field name="TEXT">for the former residents of this world, they could not find any place where they could merely survivve</field></shadow></value><next><block type="game_show_long_text" id="iOKe8QUayol`b@9E9l%M"><field name="layout">DialogLayout.Bottom</field><value name="str"><shadow type="text" id="#NoTzCutWZ!~x#nBNm~s"><field name="TEXT">and so, because of that, the mountain people flourished.</field></shadow></value><next><block type="game_show_long_text" id="#_@Oso4+f2nqKC=bS[mt"><field name="layout">DialogLayout.Bottom</field><value name="str"><shadow type="text" id="7-k]fG/?Qix}Nh|X+Qyx"><field name="TEXT">but according to legend, there is a warmer dimension</field></shadow></value><next><block type="game_show_long_text" id="bBroebuE_RFl9}@87n],"><field name="layout">DialogLayout.Bottom</field><value name="str"><shadow type="text" id="iZ1x/fad3#[=zVUykjEB"><field name="TEXT">they just need to find it</field></shadow></value><next><block type="game_show_long_text" id="W:#BixudPd^$9PQ/3tz_"><field name="layout">DialogLayout.Bottom</field><value name="str"><shadow type="text" id="0Y}lX}+uWa?g`G~E=wQ|"><field name="TEXT">you, dear reader, probably need to help them though..</field></shadow></value><next><block type="game_show_long_text" id="DRE-;H2Sg;{,2kiYgKNs"><field name="layout">DialogLayout.Bottom</field><value name="str"><shadow type="text" id=")!#JT}JgPC3-VMl{W_D`"><field name="TEXT">the portal is blue and swirly, but that's all I know</field></shadow></value><next><block type="game_show_long_text" id="qwd76C2YDn1bju28nOPp"><field name="layout">DialogLayout.Bottom</field><value name="str"><shadow type="text" id=";2[#W=QWY|[X^R+5OJ%Y"><field name="TEXT">I have heard that you can build one though..</field></shadow></value><next><block type="device_pause" id="$SL9C}tEOyLo8Ga.%t]!"><value name="pause"><shadow type="timePicker" id="_^c:=t2x4`(DalVN#AVU"><field name="ms">200</field></shadow></value><next><block type="gameSplash" id="(DWx;4Y%UbFOrz?A3ANp"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="title"><shadow type="text" id="!%N]Ly/)mZF^i2p$Dk~Y"><field name="TEXT">You feel like you have a purpose now</field></shadow></value><value name="subtitle"><shadow type="text" id="^4oz9L%?O^QQAsT9UDo4"><field name="TEXT">go fulfill your quest</field></shadow></value><next><block type="device_pause" id="Th]O5J,u[.UU!sAf`GhI"><value name="pause"><shadow type="timePicker" id="Iar:bU!Fl-^_k5hYAfJg"><field name="ms">200</field></shadow></value><next><block type="variables_set" id="t6kxJ[?%cV*ymesNyi_k"><field name="VAR" id="6cdM`faMN)`S.()_`|^F">portals?</field><value name="VALUE"><shadow type="math_number" id="yPiPpjOiCi4Kkw$CHFe;"><field name="NUM">0</field></shadow><block type="logic_boolean" id="+[{t8DxdC(:#(9#;M3js"><field name="BOOL">TRUE</field></block></value><next><block type="gameSplash" id="6Mp5mZR}@dE/9lg5ye|#"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><value name="title"><shadow type="text" id="x0x3o?(XTDe3Iqx}HXQ{"><field name="TEXT">portals are now active</field></shadow></value><value name="subtitle"><shadow type="text" id="rd_VN;1%LgM7vQuuYFw!"><field name="TEXT">go fu